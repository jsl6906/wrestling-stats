# Governing body to process (see governing_bodies.json for known values)
GOVERNING_BODY_ID=230728132
GOVERNING_BODY_ACRONYM=NVWF
GOVERNING_BODY_NAME=Northern Virginia Wrestling Federation

# Azure Database for PostgreSQL (Microsoft Entra ID authentication; no password)
# Locally, authenticate with `az login`; PGUSER defaults to your Entra UPN from the token.
PGHOST=jsl6906.postgres.database.azure.com
PGDATABASE=personal_storage
